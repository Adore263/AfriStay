{
  "name": "api",
  "version": "1.0.0",
  "description": "AfriStay India API Server",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src/",
    "migrate": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "express": "^4.18.0",
    "typescript": "^5.0.0",
    "cors": "^2.8.0",
    "@prisma/client": "^5.0.0",
    "dotenv": "^16.3.0",
    "bcryptjs": "^2.4.0",
    "jsonwebtoken": "^9.0.0",
    "socket.io": "^4.7.0",
    "axios": "^1.5.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "express-async-errors": "^3.1.0",
    "joi": "^17.11.0",
    "multer": "^1.4.0",
    "cloudinary": "^1.40.0",
    "nodemailer": "^6.9.0",
    "@sendgrid/mail": "^7.7.0",
    "twilio": "^3.94.0",
    "razorpay": "^2.9.0",
    "redis": "^4.6.0",
    "pg": "^8.10.0",
    "uuid": "^9.0.0",
    "dayjs": "^1.11.0",
    "lodash": "^4.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/cors": "^2.8.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "supertest": "^6.3.0",
    "@types/supertest": "^2.0.0",
    "prisma": "^5.0.0"
  }
}
