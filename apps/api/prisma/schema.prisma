// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USER MANAGEMENT
// ============================================

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  phone                 String?                @unique
  passwordHash          String
  role                  UserRole               @default(STUDENT)
  status                UserStatus             @default(ACTIVE)
  emailVerified         Boolean                @default(false)
  phoneVerified         Boolean                @default(false)
  profilePicture        String?
  twoFactorEnabled      Boolean                @default(false)
  twoFactorSecret       String?
  lastLogin             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  // Relations
  studentProfile        StudentProfile?
  landlordProfile       LandlordProfile?
  adminProfile          AdminProfile?
  properties            Property[]
  sentMessages          Message[]             @relation("SentMessages")
  receivedMessages      Message[]             @relation("ReceivedMessages")
  conversations         Conversation[]        @relation("ConversationParticipants")
  savedProperties       SavedProperty[]
  bookings              Booking[]
  reviews               Review[]
  roommatePro           RoommateProfile?
  roommateRequestsSent  RoommateRequest[]     @relation("SentRequests")
  roommateRequestsRecv  RoommateRequest[]     @relation("ReceivedRequests")
  subscriptions         UserSubscription[]
  payments              Payment[]
  verificationDocs      VerificationDocument[]
  communityPosts        CommunityPost[]
  forumPosts            ForumPost[]
  forumReplies          ForumReply[]
  marketplaceListings   MarketplaceListing[]
  eventAttendees        EventAttendee[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  analytics             Analytics[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

enum UserRole {
  STUDENT
  LANDLORD
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

// ============================================
// PROFILES
// ============================================

model StudentProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  firstName             String
  lastName              String
  dateOfBirth           DateTime?
  gender                String?
  nationality           String
  universityId          String?
  course                String?
  studentIdNumber       String?
  languages             String[]               @default([])
  bio                   String?
  verificationStatus    VerificationStatus     @default(PENDING)
  studentIdVerifiedAt   DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  university            University?            @relation(fields: [universityId], references: [id])

  @@index([universityId])
  @@index([verificationStatus])
}

model LandlordProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  fullName              String
  bio                   String?
  yearsOfExperience     Int                    @default(0)
  totalPropertiesManaged Int                   @default(0)
  verificationStatus    VerificationStatus     @default(PENDING)
  idVerifiedAt          DateTime?
  phoneVerifiedAt       DateTime?
  bankVerifiedAt        DateTime?
  verificationExpiryDate DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
}

model AdminProfile {
  id                    String                 @id @default(cuid())
  userId                String                 @unique
  fullName              String
  permissions           String[]               @default([])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// ============================================
// UNIVERSITIES
// ============================================

model University {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  city                  String
  state                 String?
  latitude              Float
  longitude             Float
  abbreviation          String?
  studentCount          Int                    @default(0)
  createdAt             DateTime               @default(now())

  // Relations
  students              StudentProfile[]
  roommateProfiles      RoommateProfile[]
  events                Event[]

  @@index([city])
  @@index([name])
}

// ============================================
// PROPERTIES
// ============================================

model Property {
  id                    String                 @id @default(cuid())
  landlordId            String
  title                 String
  description           String                 @db.Text
  propertyType          PropertyType
  furnishedStatus       FurnishedStatus
  bedroomCount          Int
  bathroomCount         Int
  areaSqft              Float
  floorNumber           Int?
  propertyAgeYears      Int?
  monthlyRent           Float
  securityDeposit       Float
  maintenanceCharges    Float                  @default(0)
  leaseTermMonths       Int                    @default(12)
  availableDate         DateTime
  occupancyType         String                 @default("Any")
  
  // Location
  address               String
  latitude              Float
  longitude             Float
  city                  String
  state                 String
  pincode               String
  
  // Status
  status                PropertyStatus         @default(PENDING)
  isVerified            Boolean                @default(false)
  verificationDate      DateTime?
  
  // Metrics
  viewsCount            Int                    @default(0)
  savesCount            Int                    @default(0)
  inquiriesCount        Int                    @default(0)
  ratingAverage         Float?
  reviewsCount          Int                    @default(0)
  
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  // Relations
  landlord              User                   @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  amenities             Amenity[]
  images                PropertyImage[]
  videos                PropertyVideo[]
  rules                 PropertyRule[]
  savedBy               SavedProperty[]
  bookings              Booking[]
  reviews               Review[]
  inquiries             Inquiry[]
  analytics             Analytics[]

  @@index([landlordId])
  @@index([city])
  @@index([status])
  @@index([isVerified])
  @@index([createdAt])
}

enum PropertyType {
  APARTMENT
  HOUSE
  HOSTEL
  PG
  FLAT_SHARE
  BUNGALOW
  VILLA
  STUDIO
}

enum FurnishedStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PAUSED
  OCCUPIED
  FLAGGED
  DELETED
}

model PropertyImage {
  id                    String                 @id @default(cuid())
  propertyId            String
  imageUrl              String
  imageOrder            Int
  isPrimary             Boolean                @default(false)
  uploadedAt            DateTime               @default(now())

  // Relations
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyVideo {
  id                    String                 @id @default(cuid())
  propertyId            String
  videoUrl              String
  videoType             VideoType
  durationSeconds       Int?
  uploadedAt            DateTime               @default(now())

  // Relations
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

enum VideoType {
  MP4
  YOUTUBE
  VIMEO
  MATTERPORT
}

model PropertyRule {
  id                    String                 @id @default(cuid())
  propertyId            String                 @unique
  rulesText            String                 @db.Text
  updatedAt             DateTime               @updatedAt

  // Relations
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id                    String                 @id @default(cuid())
  propertyId            String
  name                  String
  category              String
  iconName              String?

  // Relations
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ============================================
// BOOKINGS & INQUIRIES
// ============================================

model Booking {
  id                    String                 @id @default(cuid())
  studentId            String
  propertyId            String
  landlordId            String
  status                BookingStatus          @default(PENDING)
  checkInDate           DateTime
  checkOutDate          DateTime?
  bookingDate           DateTime               @default(now())
  amountPaid            Float?
  leaseDocumentUrl      String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  cancelledDate         DateTime?

  // Relations
  student               User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([propertyId])
  @@index([status])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Inquiry {
  id                    String                 @id @default(cuid())
  studentId            String
  propertyId            String
  landlordId            String
  status                InquiryStatus          @default(NEW)
  message               String                 @db.Text
  createdAt             DateTime               @default(now())
  respondedAt           DateTime?

  // Relations
  student               User                   @relation("InquiriesAsStudent", fields: [studentId], references: [id], onDelete: Cascade)
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  landlord              User                   @relation("InquiriesAsLandlord", fields: [landlordId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([propertyId])
  @@index([status])
}

enum InquiryStatus {
  NEW
  CONTACTED
  VIEWED
  BOOKED
  REJECTED
}

// ============================================
// REVIEWS & RATINGS
// ============================================

model Review {
  id                    String                 @id @default(cuid())
  propertyId            String
  studentId            String
  rating                Int
  title                 String
  text                  String                 @db.Text
  photoUrls             String[]               @default([])
  helpfulCount          Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  isFlagged             Boolean                @default(false)

  // Relations
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  student               User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([studentId])
  @@index([isFlagged])
}

// ============================================
// SAVED PROPERTIES
// ============================================

model SavedProperty {
  id                    String                 @id @default(cuid())
  studentId            String
  propertyId            String
  savedAt               DateTime               @default(now())

  // Relations
  student               User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([studentId, propertyId])
  @@index([studentId])
  @@index([propertyId])
}

// ============================================
// MESSAGING & CHAT
// ============================================

model Conversation {
  id                    String                 @id @default(cuid())
  studentId            String
  landlordId            String
  propertyId            String?
  lastMessageId         String?
  lastMessageTime       DateTime?
  isArchived            Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  participants          User[]                 @relation("ConversationParticipants")
  messages              Message[]

  @@unique([studentId, landlordId])
  @@index([studentId])
  @@index([landlordId])
}

model Message {
  id                    String                 @id @default(cuid())
  conversationId        String
  senderId              String
  receiverId            String
  content               String                 @db.Text
  attachments           String[]               @default([])
  isRead                Boolean                @default(false)
  readAt                DateTime?
  createdAt             DateTime               @default(now())

  // Relations
  conversation          Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                User                   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver              User                   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([isRead])
}

// ============================================
// SUBSCRIPTIONS & PAYMENTS
// ============================================

model Subscription {
  id                    String                 @id @default(cuid())
  planName              String                 @unique
  planCode              String                 @unique
  description           String?                @db.Text
  priceMonthly          Float?
  priceOneTime          Float?
  billingCycle          Int?                   // in months
  features              String[]               @default([])
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  userSubscriptions     UserSubscription[]

  @@index([isActive])
}

model UserSubscription {
  id                    String                 @id @default(cuid())
  userId                String
  subscriptionId        String
  razorpaySubscriptionId String?
  razorpayCustomerId    String?
  status                SubscriptionStatus    @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime?
  nextBillingDate       DateTime?
  autoRenew             Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  cancelledAt           DateTime?

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription          Subscription           @relation(fields: [subscriptionId], references: [id])

  @@unique([userId, subscriptionId])
  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

model Payment {
  id                    String                 @id @default(cuid())
  userId                String
  userSubscriptionId    String?
  razorpayPaymentId     String                 @unique
  amount                Float
  currency              String                 @default("INR")
  status                PaymentStatus          @default(CAPTURED)
  paymentMethod         String
  taxAmount             Float                  @default(0)
  description           String?
  receiptNumber         String?
  refundAmount          Float?
  refundDate            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([razorpayPaymentId])
}

enum PaymentStatus {
  CAPTURED
  FAILED
  REFUNDED
  PENDING
}

// ============================================
// ROOMMATE MATCHING
// ============================================

model RoommateProfile {
  id                    String                 @id @default(cuid())
  studentId            String                 @unique
  nationality           String
  gender                String
  universityId          String
  course                String?
  arrivalDate           DateTime
  roomTypePreference    String
  budgetMin             Float
  budgetMax             Float
  smokingPreference     String
  alcoholPreference     String?
  studyHabits           String
  sleepSchedule         String
  cleanlinessPreference String
  cookingPreference     String?
  dietaryRestrictions   String[]               @default([])
  languages             String[]               @default([])
  interests             String[]               @default([])
  petsOwned             String?
  bio                   String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  isActive              Boolean                @default(true)

  // Relations
  student               User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  university            University             @relation(fields: [universityId], references: [id])

  @@index([universityId])
}

model RoommateRequest {
  id                    String                 @id @default(cuid())
  fromStudentId        String
  toStudentId          String
  compatibilityScore    Float
  status                RoommateRequestStatus @default(PENDING)
  message               String?
  createdAt             DateTime               @default(now())
  respondedAt           DateTime?
  isDeleted             Boolean                @default(false)

  // Relations
  fromStudent           User                   @relation("SentRequests", fields: [fromStudentId], references: [id], onDelete: Cascade)
  toStudent             User                   @relation("ReceivedRequests", fields: [toStudentId], references: [id], onDelete: Cascade)

  @@index([fromStudentId])
  @@index([toStudentId])
  @@index([status])
}

enum RoommateRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

// ============================================
// COMMUNITY FEATURES
// ============================================

model MarketplaceListing {
  id                    String                 @id @default(cuid())
  sellerId              String
  title                 String
  category              String
  description           String                 @db.Text
  price                 Float
  condition             String
  quantity              Int
  images                String[]               @default([])
  location              String
  negotiable            Boolean                @default(false)
  deliveryAvailable     Boolean                @default(false)
  status                MarketplaceStatus      @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  soldDate              DateTime?

  // Relations
  seller                User                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
  @@index([category])
}

enum MarketplaceStatus {
  ACTIVE
  SOLD
  ARCHIVED
  FLAGGED
}

model Event {
  id                    String                 @id @default(cuid())
  organizerId          String
  title                 String
  description           String                 @db.Text
  eventDate             DateTime
  eventTime             String
  location              String
  latitude              Float?
  longitude             Float?
  category              String
  imageUrl              String?
  maxAttendees          Int?
  ticketPrice           Float?
  rsvpRequired          Boolean                @default(false)
  universityId          String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  university            University?            @relation(fields: [universityId], references: [id])
  attendees             EventAttendee[]

  @@index([universityId])
  @@index([eventDate])
}

model EventAttendee {
  id                    String                 @id @default(cuid())
  eventId               String
  studentId            String
  rsvpStatus            RsvpStatus             @default(YES)
  attended              Boolean                @default(false)
  createdAt             DateTime               @default(now())

  // Relations
  event                 Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student               User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([eventId])
  @@index([studentId])
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

model CommunityPost {
  id                    String                 @id @default(cuid())
  authorId              String
  content               String                 @db.Text
  images                String[]               @default([])
  likesCount            Int                    @default(0)
  commentsCount         Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  author                User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
}

model ForumPost {
  id                    String                 @id @default(cuid())
  authorId              String
  categoryId            String
  title                 String
  content               String                 @db.Text
  tags                  String[]               @default([])
  isPinned              Boolean                @default(false)
  isLocked              Boolean                @default(false)
  votesCount            Int                    @default(0)
  repliesCount          Int                    @default(0)
  isFlagged             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  author                User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category              ForumCategory          @relation(fields: [categoryId], references: [id])
  replies               ForumReply[]

  @@index([authorId])
  @@index([categoryId])
  @@index([createdAt])
}

model ForumCategory {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  description           String?
  color                 String?

  // Relations
  posts                 ForumPost[]
}

model ForumReply {
  id                    String                 @id @default(cuid())
  postId                String
  authorId              String
  content               String                 @db.Text
  votesCount            Int                    @default(0)
  isMarkedHelpful       Boolean                @default(false)
  isFlagged             Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Relations
  post                  ForumPost              @relation(fields: [postId], references: [id], onDelete: Cascade)
  author                User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

// ============================================
// VERIFICATION & DOCUMENTS
// ============================================

model VerificationDocument {
  id                    String                 @id @default(cuid())
  userId                String
  documentType          String
  documentUrl           String
  uploadDate            DateTime               @default(now())
  status                VerificationStatus     @default(PENDING)
  adminNotes            String?
  verifiedByAdminId     String?
  verifiedDate          DateTime?

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id                    String                 @id @default(cuid())
  userId                String
  type                  NotificationType
  title                 String
  message               String                 @db.Text
  actionUrl             String?
  isRead                Boolean                @default(false)
  readAt                DateTime?
  channels              NotificationChannel[]  @default([])
  deliveryStatus        DeliveryStatus         @default(PENDING)
  createdAt             DateTime               @default(now())

  // Relations
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  PROPERTY_MATCH
  INQUIRY_RECEIVED
  MESSAGE_RECEIVED
  BOOKING_CONFIRMED
  SUBSCRIPTION_EXPIRY
  VERIFICATION_APPROVED
  REVIEW_REQUEST
  ROOMMATE_MATCH
  FORUM_REPLY
  EVENT_REMINDER
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
  PUSH
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  BOUNCED
}

// ============================================
// ANALYTICS & LOGGING
// ============================================

model Analytics {
  id                    String                 @id @default(cuid())
  propertyId            String
  userId                String?
  viewDate              DateTime               @default(now())
  viewsCount            Int                    @default(1)
  clicksCount           Int                    @default(0)
  savesCount            Int                    @default(0)
  inquiriesCount        Int                    @default(0)
  bookingsCount         Int                    @default(0)

  // Relations
  property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([userId])
  @@index([viewDate])
}

model AuditLog {
  id                    String                 @id @default(cuid())
  userId                String?
  actionType            String
  entityType            String
  entityId              String
  oldValue               Json?
  newValue              Json?
  ipAddress             String?
  userAgent             String?
  statusCode            Int?
  createdAt             DateTime               @default(now())

  // Relations
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
